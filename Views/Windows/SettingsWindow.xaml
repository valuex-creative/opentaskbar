                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="DynamicIslandTab" Header="{local:Loc DynamicIslandTitle}" Tag="{StaticResource IconLayers}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="{StaticResource SettingsPageInset}" MaxWidth="{StaticResource SettingsReadingWidth}" HorizontalAlignment="Stretch">
                            <StackPanel Margin="0,0,0,22">
                                <TextBlock Text="{local:Loc DynamicIslandTitle}" Style="{StaticResource SettingsHeading}" />
                                <TextBlock Text="{local:Loc DynamicIslandEnableDescription}" Style="{StaticResource SettingsPageSubtitle}" />
                            </StackPanel>

                            <Border Style="{StaticResource SettingsRowsGroup}"><StackPanel>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <CheckBox x:Name="DynamicIslandEnabledToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                              AutomationProperties.Name="{local:Loc DynamicIslandEnable}" Checked="DynamicIslandEnabled_Changed"
                                              Unchecked="DynamicIslandEnabled_Changed" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc DynamicIslandEnable}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc DynamicIslandEnableDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <ComboBox x:Name="DynamicIslandVisibilityBox" DockPanel.Dock="Right" MinWidth="170" MaxWidth="260" Width="Auto" VerticalAlignment="Center"
