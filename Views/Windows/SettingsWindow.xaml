                                                <ComboBoxItem Content="{local:Loc DateStyleShort}" Tag="ShortDateOnly" />
                                                <ComboBoxItem Content="{local:Loc DateStyleNumeric}" Tag="NumericDate" />
                                                <ComboBoxItem Content="{local:Loc DateStyleHidden}" Tag="Hidden" />
                                            </ComboBox>
                                            <TextBlock Text="{local:Loc ClockDateStyleLabel}" Style="{StaticResource SettingsRowLabel}" FontSize="12" />
                                        </DockPanel></Border>
                                        <Border Style="{StaticResource CompactSettingsRow}"><DockPanel>
                                            <ComboBox x:Name="DateFormatBox" views:IconGlyph.Glyph="{StaticResource IconCalendar}" DockPanel.Dock="Right" MinWidth="150" MaxWidth="210" Width="Auto" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{local:Loc ClockDateFormat}" SelectionChanged="SegmentChoice_SelectionChanged">
                                                <ComboBoxItem Content="{local:Loc DateFormatSystem}" Tag="System" />
                                                <ComboBoxItem Content="{local:Loc DateFormatDdMmYyyy}" Tag="DdMmYyyy" />
                                                <ComboBoxItem Content="{local:Loc DateFormatDdMmYy}" Tag="DdMmYy" />
                                                <ComboBoxItem Content="{local:Loc DateFormatMmDdYyyy}" Tag="MmDdYyyy" />
                                                <ComboBoxItem Content="{local:Loc DateFormatYyyyMmDd}" Tag="YyyyMmDd" />
                                                <ComboBoxItem Content="{local:Loc DateFormatDdMmYyyyDots}" Tag="DdMmYyyyDots" />
                                            </ComboBox>
                                            <TextBlock Text="{local:Loc ClockDateFormat}" Style="{StaticResource SettingsRowLabel}" FontSize="12" />
                                        </DockPanel></Border>
                                        <Border Style="{StaticResource CompactSettingsRow}"><DockPanel>
                                            <ComboBox x:Name="ClockDateLayoutBox" views:IconGlyph.Glyph="{StaticResource IconCalendar}" DockPanel.Dock="Right" MinWidth="150" MaxWidth="210" Width="Auto" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{local:Loc ClockDateLayout}" SelectionChanged="SegmentChoice_SelectionChanged">
                                                <ComboBoxItem Content="{local:Loc ClockDateLayoutBeside}" Tag="Beside" />
                                                <ComboBoxItem Content="{local:Loc ClockDateLayoutBelow}" Tag="Below" />
                                            </ComboBox>
                                            <TextBlock Text="{local:Loc ClockDateLayout}" Style="{StaticResource SettingsRowLabel}" FontSize="12" />
                                        </DockPanel></Border>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="WeatherOptions" Visibility="Collapsed" Background="Transparent" BorderThickness="0">
                                    <StackPanel>
                                        <Button x:Name="CollapseWeatherOptionsButton" Visibility="Collapsed" Click="CollapseWeatherOptions_Click" />
                                        <Border Style="{StaticResource CompactSettingsRow}"><DockPanel>
                                            <views:SearchableComboBox x:Name="WeatherCountryBox" views:IconGlyph.Glyph="{StaticResource IconGlobe}" DockPanel.Dock="Right" MinWidth="170" MaxWidth="240" Width="Auto" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{local:Loc Country}"
                                                      SelectionChanged="WeatherCountryBox_SelectionChanged"
                                                      KeyUp="WeatherCountryBox_KeyUp" />
                                            <TextBlock Text="{local:Loc Country}" Style="{StaticResource SettingsRowLabel}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        </DockPanel></Border>
                                        <Border x:Name="WeatherCityContainer" Visibility="Collapsed" Style="{StaticResource CompactSettingsRow}"><DockPanel>
                                            <views:SearchableComboBox x:Name="WeatherCityCombo" views:IconGlyph.Glyph="{StaticResource IconSearch}" DockPanel.Dock="Right" MinWidth="170" MaxWidth="240" Width="Auto" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{local:Loc WeatherCity}"
                                                      SelectionChanged="WeatherCityCombo_SelectionChanged"
                                                      KeyUp="WeatherCityCombo_KeyUp" />
                                            <TextBlock Text="{local:Loc WeatherCity}" Style="{StaticResource SettingsRowLabel}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        </DockPanel></Border>
                                        <Border Style="{StaticResource CompactSettingsRow}"><DockPanel>
                                            <ComboBox x:Name="WeatherUnitBox" DockPanel.Dock="Right" MinWidth="150" MaxWidth="190" Width="Auto" VerticalAlignment="Center"
