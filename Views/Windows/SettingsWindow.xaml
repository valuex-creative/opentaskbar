<Window x:Class="OpenTaskbar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenTaskbar.Services"
        xmlns:views="clr-namespace:OpenTaskbar.Views"
        xmlns:widgets="clr-namespace:OpenTaskbar.Views.Widgets"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{local:Loc SettingsTitle}" Width="1020" Height="720" MinWidth="580" MinHeight="480" MaxWidth="1360" MaxHeight="960"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource SettingsBackground}"
        WindowStartupLocation="CenterScreen" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource InterfaceFont}" FontSize="{DynamicResource TextSizeBody}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="45" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="SettingsWidgetOptionTemplate">
                <widgets:WidgetCatalogItem HorizontalAlignment="Stretch" Margin="0"
                                           InstallationRequested="WidgetInstallation_Click"
                                           SettingsRequested="WidgetSettings_Click" />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="SettingsFrame" Background="{DynamicResource SettingsGlassMaterial}"
            CornerRadius="0" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="45" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource StrokeSubtle}" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,16,0" IsHitTestVisible="False">
                        <Border Width="17" Height="17" CornerRadius="3" BorderThickness="1.5"
                                BorderBrush="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Border Width="9" Height="1.5" Background="{DynamicResource TextPrimary}"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2.5" />
                        </Border>
                        <TextBlock Text="OpenTaskbar" FontWeight="SemiBold" FontSize="12.5"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TitleVersionText" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="1" Height="28" MaxWidth="320" MinWidth="150" Margin="8,0"
                            VerticalAlignment="Center" CornerRadius="6"
                            Background="{DynamicResource SettingsControl}"
                            BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconSearch}" Width="13" Height="13"
                                  Stretch="Uniform" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.75"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Margin="9,0,6,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBlock x:Name="SettingsSearchPlaceholder" Grid.Column="1"
                                       Text="{local:Loc SettingsSearchPlaceholder}"
                                       IsHitTestVisible="False" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="12" VerticalAlignment="Center" Margin="2,0,4,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBox x:Name="SettingsSearchBox" Grid.Column="1"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     FocusVisualStyle="{x:Null}"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"
                                     VerticalContentAlignment="Center" FontSize="12"
                                     TextChanged="SettingsSearchBox_TextChanged"
                                     AutomationProperties.Name="{local:Loc SettingsSearchPlaceholder}" />
                            <Button x:Name="SettingsSearchClearButton" Grid.Column="2" Visibility="Collapsed"
                                    Style="{StaticResource SettingsGhostButton}"
                                    views:IconGlyph.Glyph="{StaticResource IconClose}"
                                    views:IconGlyph.Size="11" views:IconGlyph.Margin="0"
                                    Padding="6,0" VerticalAlignment="Stretch"
                                    ToolTip="{local:Loc SettingsSearchClear}"
                                    AutomationProperties.Name="{local:Loc SettingsSearchClear}"
                                    Click="SettingsSearchClearButton_Click" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                                ToolTip="{local:Loc Minimize}" AutomationProperties.Name="{local:Loc Minimize}" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource MaximizeCaptionButton}" Click="Maximize_Click" />
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Click="Close_Click"
                                ToolTip="{local:Loc Close}" AutomationProperties.Name="{local:Loc Close}" />
                    </StackPanel>
                </Grid>
            </Border>
            <TabControl x:Name="SettingsTabs" Grid.Row="1" TabStripPlacement="Left" SelectedIndex="0" Style="{StaticResource SettingsSidebarTabs}" SelectionChanged="SettingsTabs_SelectionChanged">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource SettingsSidebarTab}"/>
                </TabControl.Resources>
                <TabItem Header="{local:Loc Dock}" Tag="{StaticResource IconNavDock}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="{StaticResource SettingsPageInset}" MaxWidth="{StaticResource SettingsReadingWidth}" HorizontalAlignment="Stretch">
                            <DockPanel Margin="0,0,0,26">
                                <Button DockPanel.Dock="Right" Content="{local:Loc ResetDefaults}" Style="{StaticResource SettingsGhostButton}" views:IconGlyph.Glyph="{StaticResource IconRotate}"
                                        VerticalAlignment="Top" Padding="9,5" FontSize="11.5" Click="ResetDockDefaults_Click" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{local:Loc Dock}" Style="{StaticResource SettingsHeading}" />
                                    <TextBlock Text="{local:Loc SettingsPageDock}" Style="{StaticResource SettingsPageSubtitle}" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Layout -->
                            <TextBlock Text="{local:Loc SectionDockLayout}" Style="{StaticResource SettingsSectionHeading}" Margin="0,0,0,8" />
                            <Border Style="{StaticResource SettingsRowsGroup}"><StackPanel>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <ComboBox x:Name="EdgeBox" views:IconGlyph.Glyph="{StaticResource IconLayers}" DockPanel.Dock="Right" MinWidth="150" MaxWidth="230" Width="Auto" VerticalAlignment="Center"
                                              AutomationProperties.Name="{local:Loc DockEdge}" SelectionChanged="SegmentChoice_SelectionChanged">
                                        <ComboBoxItem Content="{local:Loc EdgeBottom}" Tag="Bottom" />
                                        <ComboBoxItem Content="{local:Loc EdgeLeft}" Tag="Left" />
                                        <ComboBoxItem Content="{local:Loc EdgeRight}" Tag="Right" />
                                    </ComboBox>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc DockEdge}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc DockEdgeDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>

                                <Border x:Name="PositionRow" Style="{StaticResource SettingsRow}"><DockPanel>
                                    <ComboBox x:Name="PositionBox" views:IconGlyph.Glyph="{StaticResource IconMonitor}" DockPanel.Dock="Right" MinWidth="150" MaxWidth="280" Width="Auto" VerticalAlignment="Center"
                                              AutomationProperties.Name="{local:Loc DockAlignment}" SelectionChanged="SegmentChoice_SelectionChanged">
                                        <ComboBoxItem Content="{local:Loc Left}" Tag="Left" />
                                        <ComboBoxItem Content="{local:Loc Center}" Tag="Center" />
                                        <ComboBoxItem Content="{local:Loc Right}" Tag="Right" />
                                        <ComboBoxItem Content="{local:Loc LayoutFullWidth}" Tag="FullWidth" />
                                    </ComboBox>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc DockAlignment}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc DockAlignmentDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>

                                <Border x:Name="ContentAlignmentRow" Style="{StaticResource SettingsRow}"><DockPanel>
                                    <ComboBox x:Name="ContentAlignmentBox" views:IconGlyph.Glyph="{StaticResource IconMonitor}" DockPanel.Dock="Right" MinWidth="150" MaxWidth="280" Width="Auto" VerticalAlignment="Center"
                                              AutomationProperties.Name="{local:Loc ContentAlignment}" SelectionChanged="SegmentChoice_SelectionChanged">
                                        <ComboBoxItem Content="{local:Loc Left}" Tag="Left" />
                                        <ComboBoxItem Content="{local:Loc Center}" Tag="Center" />
                                        <ComboBoxItem Content="{local:Loc Right}" Tag="Right" />
                                    </ComboBox>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc ContentAlignment}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc ContentAlignmentDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>

                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <ComboBox x:Name="SizeBox" views:IconGlyph.Glyph="{StaticResource IconSliders}" DockPanel.Dock="Right" MinWidth="150" MaxWidth="230" Width="Auto" VerticalAlignment="Center"
                                              AutomationProperties.Name="{local:Loc DockSize}" SelectionChanged="SegmentChoice_SelectionChanged">
                                        <ComboBoxItem Content="{local:Loc SizeCompact}" Tag="Compact" />
                                        <ComboBoxItem Content="{local:Loc SizeMedium}" Tag="Medium" />
                                        <ComboBoxItem Content="{local:Loc SizeLarge}" Tag="Large" />
                                    </ComboBox>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc DockSize}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc DockSizeDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border Style="{StaticResource SettingsRowLast}"><DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" MinWidth="150" MaxWidth="230" Width="Auto" VerticalAlignment="Center">
                                        <Slider x:Name="DockIconPaddingSlider" Width="174" Minimum="0" Maximum="12" Value="0" TickFrequency="1"
                                                IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2" Style="{StaticResource SettingsOpacitySlider}"
                                                AutomationProperties.Name="{local:Loc DockIconPadding}" AutomationProperties.HelpText="{local:Loc DockIconPaddingHelp}"
                                                ValueChanged="DockIconPaddingSlider_ValueChanged" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DockIconPaddingValue" Width="48" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc DockIconPadding}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc DockIconPaddingHelp}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                            </StackPanel></Border>

                            <!-- Dimensions -->
                            <TextBlock Text="{local:Loc Dimensions}" Style="{StaticResource SettingsSectionHeading}" />
                            <Border Style="{StaticResource SettingsRowsGroup}"><StackPanel>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <ComboBox x:Name="DockWidthModeBox" views:IconGlyph.Glyph="{StaticResource IconMonitor}" DockPanel.Dock="Right" MinWidth="150" MaxWidth="230" Width="Auto" VerticalAlignment="Center"
                                              AutomationProperties.Name="{local:Loc DockWidthMode}" SelectionChanged="DockWidthModeBox_SelectionChanged">
                                        <ComboBoxItem Content="{local:Loc DockWidthAuto}" Tag="Auto" />
                                        <ComboBoxItem Content="{local:Loc DockWidthPixels}" Tag="Pixels" />
                                        <ComboBoxItem Content="{local:Loc DockWidthPercent}" Tag="Percent" />
                                        <ComboBoxItem Content="{local:Loc DockWidthFill}" Tag="Fill" />
                                    </ComboBox>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock x:Name="DockWidthModeLabel" Text="{local:Loc DockWidthMode}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock x:Name="DockWidthModeDescription" Text="{local:Loc DockWidthModeDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border x:Name="DockWidthValueRow" Style="{StaticResource SettingsRow}" Visibility="Collapsed"><DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" MinWidth="150" MaxWidth="230" Width="Auto" VerticalAlignment="Center">
                                        <Slider x:Name="DockWidthSlider" Width="174" Minimum="100" Maximum="5000" Value="900" TickFrequency="50"
                                                IsSnapToTickEnabled="True" Style="{StaticResource SettingsOpacitySlider}"
                                                AutomationProperties.Name="{local:Loc DockWidthValue}"
                                                ValueChanged="DockWidthSlider_ValueChanged" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DockWidthValue" Width="48" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock x:Name="DockWidthValueLabel" Text="{local:Loc DockWidthValue}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock x:Name="DockWidthValueDescription" Text="{local:Loc DockWidthValueDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <!-- Thickness of the horizontal dock bar. Hidden for side docks, where the width setting controls thickness. -->
                                <Border x:Name="DockHeightModeRow" Style="{StaticResource SettingsRow}"><DockPanel>
                                    <ComboBox x:Name="DockHeightModeBox" DockPanel.Dock="Right" MinWidth="150" MaxWidth="230" Width="Auto" VerticalAlignment="Center"
                                              AutomationProperties.Name="{local:Loc DockHeightMode}" SelectionChanged="DockHeightModeBox_SelectionChanged">
                                        <ComboBoxItem Content="{local:Loc DockHeightAuto}" Tag="Auto" />
                                        <ComboBoxItem Content="{local:Loc DockHeightPixels}" Tag="Pixels" />
                                        <ComboBoxItem Content="{local:Loc DockHeightPercent}" Tag="Percent" />
                                        <ComboBoxItem Content="{local:Loc DockHeightFill}" Tag="Fill" />
                                    </ComboBox>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock x:Name="DockHeightModeLabel" Text="{local:Loc DockHeightMode}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock x:Name="DockHeightModeDescription" Text="{local:Loc DockHeightModeDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border x:Name="DockHeightValueRow" Style="{StaticResource SettingsRow}" Visibility="Collapsed"><DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" MinWidth="150" MaxWidth="230" Width="Auto" VerticalAlignment="Center">
                                        <Slider x:Name="DockHeightSlider" Width="174" Minimum="24" Maximum="400" Value="48" TickFrequency="4"
                                                IsSnapToTickEnabled="True" Style="{StaticResource SettingsOpacitySlider}"
                                                AutomationProperties.Name="{local:Loc DockHeightValue}"
                                                ValueChanged="DockHeightSlider_ValueChanged" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DockHeightValue" Width="48" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock x:Name="DockHeightValueLabel" Text="{local:Loc DockHeightValue}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock x:Name="DockHeightValueDescription" Text="{local:Loc DockHeightValueDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border Style="{StaticResource SettingsRowLast}"><DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" MinWidth="150" MaxWidth="230" Width="Auto" VerticalAlignment="Center">
                                        <Slider x:Name="DockScaleSlider" Width="174" Minimum="75" Maximum="150" Value="100" TickFrequency="5"
                                                IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10" Style="{StaticResource SettingsOpacitySlider}"
                                                AutomationProperties.Name="{local:Loc DockScale}" AutomationProperties.HelpText="{local:Loc DockScaleHelp}"
                                                ValueChanged="DockScaleSlider_ValueChanged"
                                                PreviewMouseUp="DockScaleSlider_PreviewMouseUp"
                                                KeyUp="DockScaleSlider_KeyUp" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DockScaleValue" Width="48" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc DockScale}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc DockScaleHelp}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <!-- External spacing above and below the dock (outside the visible bar). Set to zero to sit flush. -->
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" MinWidth="150" MaxWidth="230" Width="Auto" VerticalAlignment="Center">
                                        <ComboBox x:Name="DockTopGapUnitBox" Width="58" VerticalAlignment="Center" SelectionChanged="DockTopGapUnitBox_SelectionChanged"
                                                  AutomationProperties.Name="{local:Loc DockTopGapUnit}">
                                            <ComboBoxItem Content="px" Tag="Pixels" />
                                            <ComboBoxItem Content="%" Tag="Percent" />
                                        </ComboBox>
                                        <Slider x:Name="DockTopGapSlider" Width="104" Minimum="0" Maximum="100" Value="0" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Style="{StaticResource SettingsOpacitySlider}"
                                                AutomationProperties.Name="{local:Loc DockTopGap}" ValueChanged="DockTopGapSlider_ValueChanged" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        <TextBlock x:Name="DockTopGapValue" Width="40" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc DockTopGap}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc DockTopGapDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border Style="{StaticResource SettingsRowLast}"><DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" MinWidth="150" MaxWidth="230" Width="Auto" VerticalAlignment="Center">
                                        <ComboBox x:Name="DockBottomGapUnitBox" Width="58" VerticalAlignment="Center" SelectionChanged="DockBottomGapUnitBox_SelectionChanged"
                                                  AutomationProperties.Name="{local:Loc DockBottomGapUnit}">
                                            <ComboBoxItem Content="px" Tag="Pixels" />
                                            <ComboBoxItem Content="%" Tag="Percent" />
                                        </ComboBox>
                                        <Slider x:Name="DockBottomGapSlider" Width="104" Minimum="0" Maximum="100" Value="6" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Style="{StaticResource SettingsOpacitySlider}"
                                                AutomationProperties.Name="{local:Loc DockBottomGap}" ValueChanged="DockBottomGapSlider_ValueChanged" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        <TextBlock x:Name="DockBottomGapValue" Width="40" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc DockBottomGap}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc DockBottomGapDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                            </StackPanel></Border>

                            <!-- Behavior -->
                            <TextBlock Text="{local:Loc SectionBehavior}" Style="{StaticResource SettingsSectionHeading}" />
                            <Border Style="{StaticResource SettingsRowsGroup}"><StackPanel>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <ComboBox x:Name="AutoHideBox" views:IconGlyph.Glyph="{StaticResource IconEyeOff}" DockPanel.Dock="Right" MinWidth="150" MaxWidth="250" Width="Auto" VerticalAlignment="Center"
                                              AutomationProperties.Name="{local:Loc AutoHide}" SelectionChanged="SegmentChoice_SelectionChanged">
                                        <ComboBoxItem Content="{local:Loc AutoHideDisabled}" Tag="Disabled" />
                                        <ComboBoxItem Content="{local:Loc AutoHideSmart}" Tag="Smart" />
                                        <ComboBoxItem Content="{local:Loc AutoHideAlways}" Tag="Always" />
                                    </ComboBox>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc AutoHide}" Style="{StaticResource SettingsRowLabel}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border x:Name="RevealOnWinKeyRow" Style="{StaticResource SettingsRow}"><DockPanel>
                                    <CheckBox x:Name="RevealOnWinKeyToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                              AutomationProperties.Name="{local:Loc RevealDockOnWinKey}" AutomationProperties.HelpText="{local:Loc RevealDockOnWinKeyDescription}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc RevealDockOnWinKey}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc RevealDockOnWinKeyDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <CheckBox x:Name="AnimationsToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                              AutomationProperties.Name="{local:Loc Animations}" AutomationProperties.HelpText="{local:Loc AnimationsDescription}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc Animations}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc AnimationsDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <CheckBox x:Name="MagnificationToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                              AutomationProperties.Name="{local:Loc Magnification}" AutomationProperties.HelpText="{local:Loc MagnificationDescription}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc Magnification}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc MagnificationDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <CheckBox x:Name="PreviewsToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                              AutomationProperties.Name="{local:Loc Previews}" AutomationProperties.HelpText="{local:Loc PreviewsDescription}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc Previews}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc PreviewsDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <CheckBox x:Name="WindowPickerToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                              AutomationProperties.Name="{local:Loc WindowPicker}" AutomationProperties.HelpText="{local:Loc WindowPickerDescription}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc WindowPicker}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc WindowPickerDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <CheckBox x:Name="HardwareAccelerationToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                              AutomationProperties.Name="{local:Loc HardwareAcceleration}" AutomationProperties.HelpText="{local:Loc HardwareAccelerationDescription}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc HardwareAcceleration}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc HardwareAccelerationDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <CheckBox x:Name="RecycleBinToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                              AutomationProperties.Name="{local:Loc ShowRecycleBin}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc ShowRecycleBin}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc ShowRecycleBinDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <CheckBox x:Name="CurrentDesktopToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                              AutomationProperties.Name="{local:Loc CurrentDesktopOnly}" AutomationProperties.HelpText="{local:Loc CurrentDesktopOnlyDescription}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc CurrentDesktopOnly}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc CurrentDesktopOnlyDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <CheckBox x:Name="SearchButtonToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                              AutomationProperties.Name="{local:Loc WidgetLauncher}" AutomationProperties.HelpText="{local:Loc WidgetLauncherDescription}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc WidgetLauncher}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc WidgetLauncherDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
