                                        <ComboBoxItem Content="{local:Loc DynamicIslandVisibilityAlways}" Tag="Always" />
                                        <ComboBoxItem Content="{local:Loc DynamicIslandVisibilityDesktopOnly}" Tag="DesktopOnly" />
                                    </ComboBox>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{local:Loc DynamicIslandVisibility}" Style="{StaticResource SettingsRowLabel}" />
                                        <TextBlock Text="{local:Loc DynamicIslandVisibilityDescription}" Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                </DockPanel></Border>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <CheckBox x:Name="DynamicIslandHideFullscreenToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
